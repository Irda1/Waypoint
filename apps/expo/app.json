{
  "expo": {
    "name": "Waypoint",
    "slug": "waypoint",
    "scheme": "waypoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "android": { "package": "com.waypoint.app" },
    "ios": { "bundleIdentifier": "com.waypoint.app", "supportsTablet": true },
    "web": { "bundler": "metro", "output": "single" }
  }
}
