# Copier en .env.local (ignoré par git). Ces deux valeurs sont PUBLIQUES par conception :
# elles finissent dans l'appli. La sécurité repose sur les règles RLS de la base.
# Ne JAMAIS mettre ici la clé « service_role » ni les clés Pexels / Country Data.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...clé-anon-ou-publishable...
# Facultatif : clé Geoapify Places (chargement rapide des lieux). Sans elle, l'appli utilise Overpass.
EXPO_PUBLIC_GEOAPIFY_KEY=
