{
  "name": "waypoint",
  "version": "0.9.0",
  "private": true,
  "description": "Waypoint — maquette de l'application compagnon de voyage (web + APK Android via Capacitor).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "serve": "node scripts/serve.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "qrcode": "^1.5.4"
  }
}
